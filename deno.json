{
  "tasks": {
    "generate": "deno run --allow-write --allow-read --allow-env \"data-generation/generate.ts\"",
    "sample": "deno run --allow-write --allow-read --allow-env \"data-generation/generate_sample.ts\"",
    "targets": "deno run --allow-write --allow-read --allow-env \"data-generation/generate_targets.ts\"",
    "clean": "rm -rf \"raw table output/\""
  },
  "imports": {
    "@google-cloud/bigquery": "npm:@google-cloud/bigquery@^7.9.1",
    "@std/csv": "jsr:@std/csv@^1.0.0",
    "@std/yaml": "jsr:@std/yaml@^1.0.0",
    "d3-random": "npm:d3-random@^3.0.1",
    "d3-time": "npm:d3-time@^3.1.0",
    "nanoid": "npm:nanoid@^5.0.9",
    "h3-js": "npm:h3-js@^4.1.0"
  },
  "compilerOptions": {
    "lib": ["deno.window"]
  }
}
